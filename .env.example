# Example .env — copy to .env and edit
# DO NOT commit the actual .env file with real keys!

# Default backend to use
BACKEND=openai_like

# OpenAI/Groq API settings
OPENAI_API_KEY=sk_xxxxx  # Replace with your API key

# UI Testing Configuration
UI_TESTS_FILE=./data/ui_tests.xlsx
UI_TESTS_SHEET=ui_tests
DIFF_THRESHOLD=0.02  # Visual diff threshold (2%)

# Database Configuration (for test storage)
DB_KIND=sqlite
DB_STRING=./data/tests.db

# Development Settings
DEBUG=True
LOG_LEVEL=INFO

OPENAI_API_BASE=https://api.openai.com/v1OPENAI_API_KEY=your_openai_api_key_hereOPENAI_API_KEY=

OPENAI_MODEL=gpt-4-mini

OPENAI_API_BASE=https://api.openai.com/v1OPENAI_API_BASE=https://api.openai.com/v1

# Ollama settings (local)

OLLAMA_BASE=http://localhost:11434OPENAI_MODEL=gpt-4-miniOPENAI_MODEL=gpt-4o-mini

OLLAMA_MODEL=llama3.1:8b



# HuggingFace settings

HF_API_KEY=hf_xxxxx  # Replace with your HuggingFace API keyOLLAMA_BASE=http://localhost:11434OLLAMA_BASE=http://localhost:11434

HF_MODEL=microsoft/Phi-3-mini-4k-instruct

HF_API_BASE=https://api-inference.huggingface.co/modelsOLLAMA_MODEL=llama3.1:8bOLLAMA_MODEL=llama3.1:8b



# Google Gemini settings

GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE  # Get from https://aistudio.google.com/app/apikey

GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta# HuggingFace# HuggingFace

GEMINI_MODEL=gemini-1.5-flash
HF_API_KEY=your_huggingface_api_key_hereHF_API_KEY=your_huggingface_api_key_here

HF_MODEL=microsoft/Phi-3-mini-4k-instructHF_MODEL=microsoft/Phi-3-mini-4k-instruct

HF_API_BASE=https://api-inference.huggingface.co/modelsHF_API_BASE=https://api-inference.huggingface.co/models



# Google Gemini

GEMINI_API_KEY=your_gemini_api_key_here# Google Gemini

GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1betaGEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-1.5-flash
